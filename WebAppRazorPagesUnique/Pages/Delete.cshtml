@page
@model WebAppRazorPagesUnique.Pages.DeleteModel
@{
}


<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4>Delete Users</h4>
        </div>

        <div class="card-body">
            <h5>Are you sure you want to delete this product?</h5>

            <dl class="row mt-3">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model._User.Name</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model._User.Email</dd>
            </dl>

            <form method="post">
                <input type="hidden"  />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </button>

                <a asp-page="/DisplayPage" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>