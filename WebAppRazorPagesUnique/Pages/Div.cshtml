@page
@model WebAppRazorPagesUnique.Pages.DivModel
@{
}



<form method="post">
    <table>
        <tr>
            <td>
                Enter x
            </td>
            <td>
                <input type="number" asp-for="_myprop.x" />
            </td>
        </tr>
        <tr>
            <td>
                Enter y
            </td>
            <td>
                <input type="number" asp-for=_myprop.y />
